rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // For this app, we'll check if the user is in the 'admins' collection or matches the owner email
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "mitaliramani1575@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidTransmission(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'type', 'status', 'createdAt']) &&
             data.keys().size() <= 7 && // Added 'plan' as optional via size check
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() > 5 && data.email.size() < 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() < 2000 &&
             data.type in ['contact', 'membership'] &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt == request.time;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['name', 'email', 'plan', 'joinedAt', 'status']) &&
             data.keys().size() == 5 &&
             data.name is string && data.email is string &&
             data.plan is string &&
             data.joinedAt == request.time &&
             data.status is string;
    }

    function isValidSpace(data) {
      return data.keys().hasAll(['name', 'capacity', 'currentOccupancy']) &&
             data.keys().size() <= 4 &&
             data.name is string &&
             data.capacity is number && data.capacity >= 0 &&
             data.currentOccupancy is number && data.currentOccupancy >= 0;
    }

    // --- Collection Rules ---

    match /transmissions/{transmissionId} {
      allow create: if isValidId(transmissionId) && isValidTransmission(incoming()) && incoming().status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    match /members/{memberId} {
      allow read, write: if isAdmin();
    }

    match /spaces/{spaceId} {
      allow read: if true; // Public can see capacity?
      allow write: if isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console or higher level
    }
  }
}
